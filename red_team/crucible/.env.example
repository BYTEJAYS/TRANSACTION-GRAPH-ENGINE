# CRUCIBLE Red Team — Environment variables
# Copy to .env and fill values. Never commit .env.

# PostgreSQL
DATABASE_URL=postgresql://red_team:password@localhost:5432/red_team

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Blue Team integration (leave blank for pre-integration / sandbox mode)
BLUE_TEAM_URL=
BLUE_TEAM_API_KEY=

# API config
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO

# Security
SECRET_KEY=
