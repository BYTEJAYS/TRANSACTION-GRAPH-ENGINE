# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production (comma-separated for multiple)
# Example: ALLOWED_ORIGINS=https://tgie.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Graph limits (keep low on free tier) ─────────────────────────────────────
GRAPH_MAX_NODES=150
GRAPH_MAX_EDGES=600

# ── Anomaly detection ─────────────────────────────────────────────────────────
ANOMALY_SCORE_THRESHOLD=0.65
ISOLATION_FOREST_CONTAMINATION=0.1

# ── Blue Team integration (separate service — leave localhost for local dev) ──
# Production: set to your deployed Blue Team Railway URL
BLUE_TEAM_URL=http://localhost:8001
BLUE_TEAM_API_KEY=changeme-graph-engine-key

# ── Database (optional — not required for demo mode) ─────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
